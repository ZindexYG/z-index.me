---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'
import Layout from '../layouts/Layout.astro'
import PageSearch from 'astro-pagefind/components/Search.astro'
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <PageSearch
      className='pagefind-ui'
      searchboxOptions={{ showImages: false }}
    />
  </main>
  <style is:global>
    :root {
      --pagefind-ui-scale: 0.8;
      --pagefind-ui-primary: #3b82f6;
      --pagefind-ui-text: #3f3f46;
      --pagefind-ui-background: #ffffff;
      --pagefind-ui-border: #e4e4e7;
      --pagefind-ui-tag: #f4f4f5;
    }
    /* 适配深色模式 */
    .dark {
      --pagefind-ui-primary: var(--color-link-dark);
      --pagefind-ui-text: var(--color-fontdefault);
      --pagefind-ui-background: var(--color-surface-dark);
      --pagefind-ui-border: var(--color-border-dark);
      --pagefind-ui-tag: var(--color-surface-hover-dark);
    }
    .pagefind-ui {
      width: 100%;
    }
  </style>
</Layout>
