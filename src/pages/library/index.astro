---
import Layout from '../../layouts/Layout.astro'

// 本地 JSON
import movieData from '../../data/douban/movie.json'
import bookData from '../../data/douban/book.json'
import gameData from '../../data/douban/game.json'
import recentData from '../../data/douban/recent.json'

// —— 工具：把不同 JSON 结构“规范化”为统一字段 ——
function normalizeRows(cat: string, jsonData: any) {
  const rows = Array.isArray(jsonData)
    ? jsonData
    : (jsonData?.data ?? jsonData?.items ?? jsonData?.results ?? [])

  if (!Array.isArray(rows)) return []

  return rows.map((raw: any) => {
    const item = raw?.item ?? raw

    // 时间字段兜底
    const created =
      raw?.created_time ??
      raw?.created_at ??
      item?.created_time ??
      item?.created_at ??
      raw?.time ??
      raw?.date ??
      raw?.updated_at ??
      raw?.date ??
      ''

    // 标题兜底
    const title =
      item?.title ??
      item?.name ??
      item?.original_title ??
      item?.subject ??
      raw?.title ??
      ''

    // 封面兜底
    const cover =
      item?.cover_image_url ??
      item?.cover ??
      item?.image ??
      item?.poster ??
      item?.pic ??
      item?.thumbnail ??
      raw?.cover ??
      ''

    // 唯一 ID 兜底（从 link 提取）
    let uuid = item?.uuid ?? item?.id ?? item?.slug ?? item?.sid ?? ''
    if (!uuid && raw?.link) {
      const parts = raw.link.split('/')
      uuid = parts[parts.length - 2] || parts[parts.length - 1]
    }

    return {
      ...raw,
      _item: item,
      _created: created,
      _title: title,
      _cover: cover,
      _uuid: uuid,
      _rating: raw?.rating ?? item?.rating ?? raw?.rate ?? item?.rate ?? null,
      _comment: raw?.comment ?? item?.comment ?? raw?.notes ?? item?.notes ?? '',
      category: raw.category || cat,
    }
  })
}

// 处理本地数据
const grouped = {
  movie: normalizeRows('movie', movieData),
  tv: normalizeRows('tv', movieData), // 目前共用
  book: normalizeRows('book', bookData),
  game: normalizeRows('game', gameData),
}

// 使用 normalizeRows 处理最近 30 条数据，并按时间排序
const mergedRecentItems = normalizeRows('recent', recentData)
  .sort((a, b) => (new Date(b._created) as any) - (new Date(a._created) as any))

const tabs = [
  {
    id: 'recent',
    label: 'Latest 30',
    items: mergedRecentItems,
    checked: true,
  },
  { id: 'movie', label: '影', items: grouped.movie },
  { id: 'tv', label: '剧', items: grouped.tv, hideTab: true },
  { id: 'book', label: '书', items: grouped.book },
  { id: 'game', label: '游', items: grouped.game },
]

// 跳转链接（优先使用原始 link；否则构建到豆瓣的对应页面）
const getLink = (entry: any) => {
  if (entry.link) return entry.link
  const id = entry._uuid || ''
  if (!id) return '#'

  switch (entry.category) {
    case 'movie':
    case 'tv':
      return `https://movie.douban.com/subject/${id}`
    case 'book':
      return `https://book.douban.com/subject/${id}`
    case 'game':
      // 通用豆瓣条目页面，游戏在部分场景下没有独立二级域名
      return `https://www.douban.com/subject/${id}`
    default:
      return `https://douban.com/subject/${id}`
  }
}

const getShortTitle = (title: string) => title.split(' / ')[0].trim()

const categoryLabels: Record<string, string> = {
  movie: '影视',
  tv: '剧集',
  book: '阅读',
  game: '游戏',
}
---

<Layout title='书影游档案' description='YG 的精神食粮'>
  <div class='container mx-auto'>
    <div class='tabset mb-6'>
      {
        tabs.map(tab => (
          <input
            id={`tab-${tab.id}`}
            type='radio'
            name='neoTabs'
            class='tab-input'
            checked={tab.checked}
          />
        ))
      }

      <div
        class='tabs flex flex-wrap gap-2 md:gap-3 border-b border-black/10 dark:border-white/10 pb-2'>
        {
          tabs
            .filter(t => !t.hideTab)
            .map(tab => (
              <label
                for={`tab-${tab.id}`}
                class='group flex justify-between gap-3 text-sm px-2 py-1 rounded bg-bgdefault dark:bg-fontdefault text-fontdefault dark:text-bgdefault cursor-pointer'>
                {tab.label}
              </label>
            ))
        }
      </div>

      <div class='panels mt-6'>
        {
          tabs.map(tab => (
            <section id={`panel-${tab.id}`} class='tab-panel'>
              {tab.items?.length ? (
                <div class='grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-6'>
                  {tab.items.map((entry, entryIndex) => (
                    <div class='library-card group relative'>
                      <a
                        href={getLink(entry)}
                        target='_blank'
                        rel='noopener noreferrer'
                        class='block rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500'>
                        <div class='relative aspect-[2/3] overflow-hidden rounded-md bg-zinc-100 shadow-sm ring-1 ring-black/5 dark:bg-surface-dark dark:ring-white/10'>
                          <img
                            src={entry._cover}
                            alt={entry._title}
                            loading='lazy'
                            decoding='async'
                            class='library-cover block h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.025] motion-reduce:transition-none'
                            onerror="this.style.opacity='0'; this.nextElementSibling.style.display='flex';"
                          />
                          <div
                            class='hidden absolute inset-0 flex-col items-center justify-center bg-zinc-100 dark:bg-surface-dark cursor-pointer'
                            onclick="event.preventDefault(); const img = this.previousElementSibling; img.src = img.src.split('?')[0] + '?t=' + Date.now(); img.style.opacity='1'; this.style.display='none';">
                            <span class='text-xs text-gray-400'>加载失败</span>
                            <span class='text-xs text-blue-500'>点击重试</span>
                          </div>
                        </div>
                        <p
                          class='mt-2 w-full truncate text-sm font-medium text-zinc-800 dark:text-fontdefault'
                          title={entry._title}>
                          {getShortTitle(entry._title)}
                        </p>
                      </a>
                      <button
                        type='button'
                        class='note-toggle absolute right-2 top-2 z-30 rounded-full border border-white/30 bg-black/45 px-2.5 py-1 font-mono text-[10px] tracking-wide text-white shadow-sm backdrop-blur transition hover:bg-black/65 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400'
                        aria-expanded='false'
                        aria-controls={`note-${tab.id}-${entryIndex}`}
                        data-note-toggle>
                        手记
                      </button>
                      <div
                        id={`note-${tab.id}-${entryIndex}`}
                        class='library-note invisible pointer-events-none absolute inset-x-2 bottom-10 z-20 flex max-h-[calc(100%-3rem)] translate-y-2 flex-col overflow-y-auto rounded-md border border-black/10 bg-[#f4efe9]/95 p-3 text-[#26231f] opacity-0 shadow-xl backdrop-blur-sm transition duration-200 ease-out group-hover:visible group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 dark:border-border-dark dark:bg-surface-dark dark:text-fontdefault motion-reduce:transition-none'>
                        <div class='mb-2 flex items-center justify-between gap-2 border-b border-black/10 pb-2 dark:border-border-dark'>
                          <span class='font-mono text-[10px] uppercase tracking-[0.12em] text-zinc-500 dark:text-muted-dark'>
                            {categoryLabels[entry.category] || '收藏'} · {entry._created}
                          </span>
                          <span class='shrink-0 font-mono text-xs tabular-nums text-amber-700 dark:text-accent-dark'>
                            {entry._rating > 0 ? `★ ${entry._rating}/5` : '未评分'}
                          </span>
                        </div>
                        <h2 class='mb-2 text-sm font-semibold leading-snug'>
                          {getShortTitle(entry._title)}
                        </h2>
                        <p class='whitespace-pre-line break-words text-sm leading-relaxed text-zinc-700 dark:text-muted-dark'>
                          {entry._comment || '还没有写下短评。'}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <p class='text-gray-500'>
                  {tab.id === 'recent' ? '暂无最近记录' : '暂无数据'}
                </p>
              )}
              {tab.id === 'recent' && (
                <p class='mt-10 text-sm text-gray-400 text-center'>
                  ⚠️偶尔会对之前看过的内容进行查漏补缺
                </p>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </div>

  <style>
    .library-card a:focus-visible ~ .library-note {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .library-card a:focus-visible .library-cover {
      transform: scale(1.025);
    }

    .library-card.is-open .library-note {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .library-card.is-open .library-cover {
      transform: scale(1.025);
    }

    .library-card.is-open .note-toggle {
      background-color: rgb(0 0 0 / 0.72);
    }

    @media (prefers-reduced-motion: reduce) {
      .library-note,
      .library-cover,
      .note-toggle {
        transition-duration: 0ms;
      }
    }

    /* 隐藏 radio */
    .tab-input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    /* 面板显示/隐藏 */
    .tab-panel {
      display: none;
    }
    #tab-recent:checked ~ .panels #panel-recent {
      display: block;
    }
    #tab-movie:checked ~ .panels #panel-movie {
      display: block;
    }
    #tab-tv:checked ~ .panels #panel-tv {
      display: block;
    }
    #tab-book:checked ~ .panels #panel-book {
      display: block;
    }
    #tab-game:checked ~ .panels #panel-game {
      display: block;
    }
  </style>

  <script>
    const closeNotes = (except?: HTMLElement) => {
      document.querySelectorAll<HTMLElement>('.library-card.is-open').forEach((card) => {
        if (card === except) return
        card.classList.remove('is-open')
        card.querySelector<HTMLButtonElement>('[data-note-toggle]')?.setAttribute('aria-expanded', 'false')
      })
    }

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return

      const button = event.target.closest<HTMLButtonElement>('[data-note-toggle]')
      if (button) {
        const card = button.closest<HTMLElement>('.library-card')
        if (!card) return

        const shouldOpen = !card.classList.contains('is-open')
        closeNotes(card)
        card.classList.toggle('is-open', shouldOpen)
        button.setAttribute('aria-expanded', String(shouldOpen))
        return
      }

      if (!event.target.closest('.library-card')) closeNotes()
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return

      const card = event.target instanceof Element
        ? event.target.closest<HTMLElement>('.library-card.is-open')
        : null
      closeNotes()
      card?.querySelector<HTMLButtonElement>('[data-note-toggle]')?.focus()
    })
  </script>
</Layout>
