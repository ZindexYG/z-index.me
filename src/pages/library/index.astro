---
import { readFile } from 'node:fs/promises'
import { Sparkles } from '@lucide/astro'
import { imageMetadata } from 'astro/assets/utils'

// 本地 JSON
import movieData from '../../data/douban/movie.json'
import bookData from '../../data/douban/book.json'
import gameData from '../../data/douban/game.json'
import recentData from '../../data/douban/recent.json'
import Layout from '../../layouts/Layout.astro'
import { normalizeLibraryRows, selectLatestLibraryEntries } from '../../lib/library-archive.js'

// 处理本地数据
const grouped = {
  movie: normalizeLibraryRows('movie', movieData),
  tv: normalizeLibraryRows('tv', movieData), // 目前共用
  book: normalizeLibraryRows('book', bookData),
  game: normalizeLibraryRows('game', gameData),
}

// 使用档案模块处理最近 30 条数据，并按时间排序
const mergedRecentItems = selectLatestLibraryEntries(
  normalizeLibraryRows('recent', recentData),
  30,
)

const tabs = [
  {
    id: 'recent',
    label: 'Latest 30',
    items: mergedRecentItems,
    checked: true,
  },
  { id: 'movie', label: '影', items: grouped.movie },
  { id: 'tv', label: '剧', items: grouped.tv, hideTab: true },
  { id: 'book', label: '书', items: grouped.book },
  { id: 'game', label: '游', items: grouped.game },
]

const coverSizes = new Map<string, { width: number, height: number }>()
const localCovers = new Set<string>(
  tabs.flatMap(tab => tab.items.map(entry => entry._cover))
    .filter(cover => typeof cover === 'string' && /^\/library\/[\w-]+\/[\w.-]+\.[a-z\d]+$/i.test(cover)),
)

// Reserve the actual cover size before the browser loads the image.
for (const cover of localCovers) {
  try {
    const { width, height } = await imageMetadata(await readFile(`public${cover}`))
    coverSizes.set(cover, { width, height })
  }
  catch {
    // Missing or unreadable assets use the standard cover placeholder.
  }
}

// 跳转链接（优先使用原始 link；否则构建到豆瓣的对应页面）
const getLink = (entry: any) => {
  if (entry.link) return entry.link
  const id = entry._uuid || ''
  if (!id) return '#'

  switch (entry.category) {
    case 'movie':
    case 'tv':
      return `https://movie.douban.com/subject/${id}`
    case 'book':
      return `https://book.douban.com/subject/${id}`
    case 'game':
      // 通用豆瓣条目页面，游戏在部分场景下没有独立二级域名
      return `https://www.douban.com/subject/${id}`
    default:
      return `https://douban.com/subject/${id}`
  }
}

const getShortTitle = (title: string) => title.split(' / ')[0].trim()

const categoryLabels: Record<string, string> = {
  movie: '影视',
  tv: '剧集',
  book: '阅读',
  game: '游戏',
}
---

<Layout title='书影游档案' description='YG 的精神食粮'>
  <div class='container mx-auto'>
    <div class='tabset mb-6'>
      {
        tabs.map(tab => (
          <input
            id={`tab-${tab.id}`}
            type='radio'
            name='neoTabs'
            class='tab-input'
            checked={tab.checked}
          />
        ))
      }

      <div
        class='tabs flex flex-wrap gap-2 md:gap-3 border-b border-black/10 dark:border-white/10 pb-2'>
        {
          tabs
            .filter(t => !t.hideTab)
            .map(tab => (
              <label
                for={`tab-${tab.id}`}
                class='group flex justify-between gap-3 text-sm px-2 py-1 rounded bg-bgdefault dark:bg-fontdefault text-fontdefault dark:text-bgdefault cursor-pointer'>
                {tab.label}
              </label>
            ))
        }
      </div>

      <div class='panels mt-6'>
        {
          tabs.map(tab => (
            <section id={`panel-${tab.id}`} class='tab-panel'>
              {tab.items?.length ? (
                <div class='library-grid'>
                  {tab.items.map((entry, index) => {
                    const comment = entry._comment?.trim()
                    const noteId = comment ? `library-note-${tab.id}-${index}` : undefined
                    const { width, height } = coverSizes.get(entry._cover) ?? { width: 300, height: 450 }

                    return (
                      <div class:list={['library-card', Number(entry._rating) === 5 && 'is-five-star']}>
                        <a
                          href={getLink(entry)}
                          target='_blank'
                          rel='noopener noreferrer'
                          class='library-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500'
                          aria-describedby={noteId}>
                          <div class='library-artwork relative overflow-hidden rounded-md bg-zinc-100 shadow-sm ring-1 ring-black/5 dark:bg-surface-dark dark:ring-white/10'>
                            <img
                              src={entry._cover}
                              alt={entry._title}
                              width={width}
                              height={height}
                              loading='lazy'
                              decoding='async'
                              class='library-cover block w-full object-cover'
                              onerror="this.style.opacity='0'; this.nextElementSibling.style.display='flex';"
                            />
                            <div
                              class='hidden absolute inset-0 z-10 flex-col items-center justify-center bg-zinc-100 dark:bg-surface-dark cursor-pointer'
                              onclick="event.preventDefault(); const img = this.previousElementSibling; img.src = img.src.split('?')[0] + '?t=' + Date.now(); img.style.opacity='1'; this.style.display='none';">
                              <span class='text-xs text-gray-400'>加载失败</span>
                              <span class='text-xs text-blue-500'>点击重试</span>
                            </div>
                            <div class='library-caption absolute inset-0 flex flex-col justify-end p-3 sm:p-4'>
                              <span class='mb-1 text-[10px] font-medium uppercase tracking-[0.16em] text-white/75'>
                                {categoryLabels[entry.category] || '收藏'}
                              </span>
                              <p class='line-clamp-2 text-sm font-semibold leading-snug text-white sm:text-base' title={entry._title}>
                                {getShortTitle(entry._title)}
                              </p>
                            </div>
                          </div>
                        </a>
                        {comment && (
                          <aside id={noteId} class='library-note' role='tooltip' hidden>
                            <div class='mb-2 flex items-center justify-between gap-2 border-b border-black/10 pb-2 dark:border-border-dark'>
                              <span class='font-mono text-[10px] tracking-[0.12em] text-zinc-600 dark:text-muted-dark'>
                                {categoryLabels[entry.category] || '收藏'} · {entry._created}
                              </span>
                              <span class='note-rating inline-flex shrink-0 items-center gap-1 font-mono text-xs tabular-nums text-amber-700 dark:text-accent-dark'>
                                {entry._rating > 0 ? <><Sparkles class='size-3.5' aria-hidden='true' /><span>{entry._rating}/5</span></> : '未评分'}
                              </span>
                            </div>
                            <h2 class='mb-2 text-sm font-semibold leading-snug'>
                              {getShortTitle(entry._title)}
                            </h2>
                            <p class='whitespace-pre-line break-words text-sm leading-relaxed text-zinc-700 dark:text-muted-dark'>
                              {comment}
                            </p>
                          </aside>
                        )}
                      </div>
                    )
                  })}
                </div>
              ) : (
                <p class='text-gray-500'>
                  {tab.id === 'recent' ? '暂无最近记录' : '暂无数据'}
                </p>
              )}
              {tab.id === 'recent' && (
                <p class='mt-10 text-sm text-gray-400 text-center'>
                  ⚠️偶尔会对之前看过的内容进行查漏补缺
                </p>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </div>

  <style>
    .library-grid {
      --library-columns: 3;
      position: relative;
      display: grid;
      grid-template-columns: repeat(var(--library-columns), minmax(0, 1fr));
      align-items: start;
      gap: 1rem;
    }

    .library-grid[data-masonry] {
      height: var(--masonry-height);
    }

    .library-grid[data-masonry] > .library-card {
      position: absolute;
      grid-column: var(--masonry-column) / span 1;
      inset-inline: 0;
      top: var(--masonry-top);
    }

    .library-link,
    .library-artwork {
      display: block;
    }

    @property --library-cover-zoom {
      syntax: '<number>';
      inherits: false;
      initial-value: 0;
    }

    @property --library-cover-pulse {
      syntax: '<number>';
      inherits: false;
      initial-value: 0.012;
    }

    @property --library-rainbow-angle {
      syntax: '<angle>';
      inherits: false;
      initial-value: 0deg;
    }

    .library-cover {
      height: auto;
      filter: brightness(0.78) saturate(0.88);
      scale: calc(1 + var(--library-cover-zoom, 0) * var(--library-cover-pulse, 0.012));
      transition: filter 500ms ease, --library-cover-zoom 650ms ease;
      animation: library-cover-breathe 6s ease-in-out infinite alternate paused;
    }

    .library-caption {
      background: linear-gradient(180deg, transparent 45%, rgb(0 0 0 / 0.72));
    }

    .library-card:is(:hover, :focus-within) .library-cover {
      filter: brightness(1.04) saturate(1.08);
      --library-cover-zoom: 1;
      animation-play-state: running;
    }

    @keyframes library-cover-breathe {
      to { --library-cover-pulse: 0.052; }
    }

    .is-five-star {
      --spectrum: #f28c9e, #fbd58d, #8fe2b8, #82d8ed, #ac9bed, #f1a3ce, #f28c9e;
    }

    .is-five-star .library-artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      padding: 2px;
      border-radius: inherit;
      background: conic-gradient(from var(--library-rainbow-angle, 0deg), var(--spectrum));
      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      mask-composite: exclude;
      pointer-events: none;
      opacity: 0;
      transition: opacity 350ms ease;
      animation: library-rainbow 8s linear infinite paused;
    }

    .is-five-star:is(:hover, :focus-within) .library-artwork::after {
      opacity: 1;
      animation-play-state: running;
    }

    @keyframes library-rainbow {
      to { --library-rainbow-angle: 1turn; }
    }

    .is-five-star .note-rating {
      padding-bottom: 2px;
      background: linear-gradient(90deg, var(--spectrum)) left bottom / 190% 2px no-repeat;
      animation: library-spectrum 4s ease-in-out infinite alternate;
    }

    @keyframes library-spectrum {
      from { background-position-x: 100%; }
      to { background-position-x: 0%; }
    }

    .library-note {
      position: fixed;
      z-index: 45;
      inset-inline: 0;
      bottom: max(1rem, env(safe-area-inset-bottom));
      width: min(19rem, calc(100% - 2rem));
      max-height: 40dvh;
      margin-inline: auto;
      overflow: auto;
      overscroll-behavior: contain;
      overflow-wrap: anywhere;
      padding: 1rem 1.125rem;
      border: 1px solid var(--border-color);
      border-radius: 0.65rem;
      background: #fbf9f5;
      box-shadow: 0 8px 24px rgb(35 28 20 / 0.12);
    }

    :global(.dark) .library-note {
      background: var(--color-surface-dark);
    }

    /* Place the note in the margin beside the same 48rem shell used by the header. */
    @media (min-width: 80rem) {
      .library-note {
        inset: var(--note-top, 5rem) auto auto calc(50% + 24rem);
        width: min(18rem, calc(50% - 25rem));
        max-height: calc(100dvh - 6rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .library-cover {
        scale: none;
      }

      .library-cover,
      .is-five-star .library-artwork::after,
      .is-five-star .note-rating {
        animation: none;
        transition: none;
      }
    }

    @media (max-width: 767px) {
      .library-grid {
        --library-columns: 2;
      }
    }

    @media (max-width: 480px) {
      .library-grid {
        --library-columns: 1;
      }
    }

    /* 隐藏 radio */
    .tab-input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    /* 面板显示/隐藏 */
    .tab-panel {
      display: none;
    }
    #tab-recent:checked ~ .panels #panel-recent {
      display: block;
    }
    #tab-movie:checked ~ .panels #panel-movie {
      display: block;
    }
    #tab-tv:checked ~ .panels #panel-tv {
      display: block;
    }
    #tab-book:checked ~ .panels #panel-book {
      display: block;
    }
    #tab-game:checked ~ .panels #panel-game {
      display: block;
    }
  </style>

  <script>
    let activeCard: HTMLElement | null = null
    let activeNote: HTMLElement | null = null
    let closeTimer: number | undefined
    const wideGutter = window.matchMedia('(min-width: 80rem)')

    function closeNote() {
      window.clearTimeout(closeTimer)
      if (activeNote) activeNote.hidden = true
      activeNote = null
      activeCard = null
    }

    function positionNote() {
      if (!activeNote || !activeCard || !wideGutter.matches) return
      const cardTop = activeCard.getBoundingClientRect().top
      const lastTop = window.innerHeight - activeNote.offsetHeight - 16
      activeNote.style.setProperty('--note-top', `${Math.max(16, Math.min(cardTop, lastTop))}px`)
    }

    function showNote(card: HTMLElement) {
      window.clearTimeout(closeTimer)
      if (card === activeCard) return
      closeNote()
      const note = card.querySelector<HTMLElement>('.library-note')
      if (!note) return
      activeCard = card
      activeNote = note
      note.hidden = false
      positionNote()
    }

    document.querySelectorAll<HTMLElement>('.library-grid').forEach((grid) => {
      const covers = [...grid.querySelectorAll<HTMLImageElement>('.library-cover')]
      let arrangedWidth = 0

      function arrangeCards(width: number) {
        const style = getComputedStyle(grid)
        const columnCount = Number(style.getPropertyValue('--library-columns'))
        if (columnCount <= 1) {
          grid.removeAttribute('data-masonry')
          return
        }

        const gap = Number.parseFloat(style.columnGap)
        const cardWidth = (width - gap * (columnCount - 1)) / columnCount
        const nextTop = Array.from({ length: columnCount }, () => 0)

        // Keep DOM order for keyboard navigation. Equal columns fill left to right.
        for (const cover of covers) {
          const card = cover.closest<HTMLElement>('.library-card')
          if (!card) continue

          const column = nextTop.indexOf(Math.min(...nextTop))
          const coverWidth = cover.naturalWidth || Number(cover.getAttribute('width'))
          const coverHeight = cover.naturalHeight || Number(cover.getAttribute('height'))
          card.style.setProperty('--masonry-column', String(column + 1))
          card.style.setProperty('--masonry-top', `${nextTop[column]}px`)
          nextTop[column] += cardWidth * coverHeight / coverWidth + gap
        }

        grid.style.setProperty('--masonry-height', `${Math.max(...nextTop) - gap}px`)
        grid.setAttribute('data-masonry', '')
        positionNote()
      }

      if (typeof ResizeObserver !== 'undefined') {
        const resize = new ResizeObserver(([entry]) => {
          const { width } = entry.contentRect
          if (width === arrangedWidth) return
          arrangedWidth = width
          if (width > 0) arrangeCards(width)
        })
        resize.observe(grid)
      }

      grid.addEventListener('load', (event) => {
        const cover = event.target
        if (!(cover instanceof HTMLImageElement) || arrangedWidth === 0) return
        const width = Number(cover.getAttribute('width'))
        const height = Number(cover.getAttribute('height'))
        if (cover.naturalWidth * height !== cover.naturalHeight * width) arrangeCards(arrangedWidth)
      }, true)

      grid.addEventListener('pointerover', (event) => {
        if (event.pointerType === 'touch' || !(event.target instanceof Element)) return
        if (activeNote?.contains(event.target)) {
          window.clearTimeout(closeTimer)
          return
        }
        const card = event.target.closest<HTMLElement>('.library-card')
        if (card && !(event.relatedTarget instanceof Node && card.contains(event.relatedTarget))) showNote(card)
      })

      grid.addEventListener('pointerout', (event) => {
        if (!(event.target instanceof Node) || !activeCard?.contains(event.target)) return
        if (event.relatedTarget instanceof Node && activeCard.contains(event.relatedTarget)) return
        if (activeCard.querySelector(':focus-visible')) return
        // Allow the pointer to cross the small gutter and read or scroll the note.
        closeTimer = window.setTimeout(closeNote, 150)
      })

      grid.addEventListener('focusin', (event) => {
        if (!(event.target instanceof Element) || !event.target.matches(':focus-visible')) return
        const card = event.target.closest<HTMLElement>('.library-card')
        if (card) showNote(card)
      })

      grid.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && activeCard?.contains(event.relatedTarget)) return
        closeNote()
      })
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeNote()
    })
    document.addEventListener('change', (event) => {
      if (event.target instanceof Element && event.target.matches('.tab-input')) closeNote()
    })
    window.addEventListener('resize', positionNote)
    window.addEventListener('scroll', positionNote, { passive: true })
  </script>
</Layout>
