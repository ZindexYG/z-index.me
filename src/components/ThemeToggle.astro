<script>
  type Theme = 'light' | 'dark'

  const THEME_KEY = 'theme'
  const root = document.documentElement
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  let isTransitioning = false

  function storedTheme(): Theme | null {
    try {
      const value = localStorage.getItem(THEME_KEY)
      return value === 'light' || value === 'dark' ? value : null
    }
    catch {
      return null
    }
  }

  function currentTheme(): Theme {
    return root.classList.contains('dark') ? 'dark' : 'light'
  }

  function syncControls(theme: Theme) {
    const targetTheme = theme === 'dark' ? 'light' : 'dark'
    const label = `Switch to ${targetTheme} theme`

    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.disabled = isTransitioning
      button.setAttribute('aria-label', label)
      button.setAttribute('aria-pressed', String(theme === 'dark'))
      button.title = label

      const accessibleLabel = button.querySelector<HTMLElement>('[data-theme-label]')
      if (accessibleLabel)
        accessibleLabel.textContent = label
    })
  }

  function applyTheme(theme: Theme, persist = false) {
    root.classList.toggle('dark', theme === 'dark')
    root.dataset.theme = theme

    if (persist) {
      try {
        localStorage.setItem(THEME_KEY, theme)
      }
      catch {
        // Theme switching still works when storage is unavailable.
      }
    }

    syncControls(theme)
  }

  function finishTransition(button: HTMLButtonElement) {
    isTransitioning = false
    delete root.dataset.themeTransition
    button.removeAttribute('data-theme-transition-trigger')
    root.style.removeProperty('--theme-transition-top')
    root.style.removeProperty('--theme-transition-right')
    root.style.removeProperty('--theme-transition-bottom')
    root.style.removeProperty('--theme-transition-left')
    root.style.removeProperty('--theme-transition-corner-radius')
    syncControls(currentTheme())
  }

  async function toggleTheme(button: HTMLButtonElement) {
    if (isTransitioning)
      return

    const nextTheme: Theme = currentTheme() === 'dark' ? 'light' : 'dark'
    const rect = button.getBoundingClientRect()
    const startViewTransition = document.startViewTransition?.bind(document)

    isTransitioning = true
    syncControls(currentTheme())

    if (reducedMotion.matches || !startViewTransition) {
      applyTheme(nextTheme, true)
      window.setTimeout(finishTransition, reducedMotion.matches ? 0 : 400, button)
      return
    }

    root.dataset.themeTransition = `to-${nextTheme}`
    root.style.setProperty('--theme-transition-top', `${Math.max(0, rect.top)}px`)
    root.style.setProperty('--theme-transition-right', `${Math.max(0, window.innerWidth - rect.right)}px`)
    root.style.setProperty('--theme-transition-bottom', `${Math.max(0, window.innerHeight - rect.bottom)}px`)
    root.style.setProperty('--theme-transition-left', `${Math.max(0, rect.left)}px`)
    root.style.setProperty('--theme-transition-corner-radius', getComputedStyle(button).borderRadius)
    button.setAttribute('data-theme-transition-trigger', '')

    const transition = startViewTransition(() => applyTheme(nextTheme, true))

    await transition.finished.catch(() => undefined)
    finishTransition(button)
  }

  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Element))
      return

    const button = target.closest<HTMLButtonElement>('[data-theme-toggle]')
    if (button)
      void toggleTheme(button)
  })

  systemTheme.addEventListener('change', (event) => {
    if (!storedTheme())
      applyTheme(event.matches ? 'dark' : 'light')
  })

  applyTheme(currentTheme())
</script>

<style>
  .theme-icon {
    grid-area: 1 / 1;
    transition:
      opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.35);
  }

  .theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .theme-icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .theme-icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.35);
  }

  [data-theme-transition-trigger] .theme-icon-stage {
    view-transition-name: theme-icon;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-icon {
      transition: none;
    }
  }
</style>
